{
  "manifestVersion": 1,
  "id": "parallx.workspace-graph",
  "name": "Workspace Graph",
  "version": "0.1.0",
  "publisher": "parallx",
  "description": "Interactive force-directed graph visualization of workspace data: files, canvas pages, and AI sessions.",
  "main": "main.js",
  "activationEvents": ["onStartupFinished"],
  "engines": {
    "parallx": "^0.1.0"
  },
  "capabilities": {
    "fs": { "scope": "workspace-files", "modes": ["read", "write"] }
  },
  "contributes": {
    "commands": [
      { "id": "workspaceGraph.open", "title": "Open Full Graph", "category": "Workspace Graph",
        "aiInvocable": true, "aiDescription": "Open the workspace graph visualization." },
      { "id": "workspaceGraph.refresh", "title": "Refresh", "category": "Workspace Graph",
        "aiInvocable": true, "aiDescription": "Refresh the workspace graph data." },
      { "id": "workspaceGraph.rebuildConceptualLinks", "title": "Rebuild Conceptual Links", "category": "Workspace Graph",
        "aiInvocable": true, "aiDescription": "Recompute the semantic edges in the workspace graph." }
    ],
    "views": [
      {
        "id": "view.workspaceGraph",
        "name": "Workspace Graph",
        "defaultContainerId": "view.explorer"
      }
    ],
    "editors": [
      {
        "typeId": "workspace-graph",
        "displayName": "Workspace Graph"
      }
    ]
  }
}
