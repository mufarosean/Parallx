{
  "manifestVersion": 1,
  "id": "parallx-community.creations-ai",
  "name": "Creations AI",
  "version": "0.7.0",
  "publisher": "parallx-community",
  "description": "Characters, roleplay and stories with the model you choose: a Character Studio with sources and a Twist, lorebooks, memory, and a fully inspectable prompt pipeline.",
  "main": "main.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:textGenerator.newCharacter",
    "onCommand:textGenerator.newChat",
    "onCommand:textGenerator.openHome",
    "onCommand:textGenerator.openCharacters",
    "onCommand:textGenerator.openSettings",
    "onView:textGenerator.home",
    "onCommand:textGenerator.openStories",
    "onCommand:textGenerator.newStory",
    "onCommand:textGenerator.openTables",
    "onCommand:textGenerator.newTable"
  ],
  "engines": {
    "parallx": "^0.1.0"
  },
  "contributes": {
    "commands": [
      {
        "id": "textGenerator.newCharacter",
        "title": "Creations AI: New Character",
        "category": "Creations AI",
        "aiInvocable": true,
        "aiDescription": "Open the Character Studio with an empty sheet: a character from a concept, from sources, or from sources with a Twist."
      },
      {
        "id": "textGenerator.newChat",
        "title": "Creations AI: New Chat",
        "category": "Creations AI",
        "aiInvocable": true,
        "aiDescription": "Start a new Creations AI roleplay chat."
      },
      {
        "id": "textGenerator.openHome",
        "title": "Creations AI: Home",
        "category": "Creations AI",
        "aiInvocable": true,
        "aiDescription": "Open the Creations AI home page."
      },
      {
        "id": "textGenerator.openCharacters",
        "title": "Creations AI: Characters",
        "category": "Creations AI",
        "aiInvocable": true,
        "aiDescription": "Open the Creations AI character roster."
      },
      {
        "id": "textGenerator.openSettings",
        "title": "Creations AI: Settings",
        "category": "Creations AI",
        "aiInvocable": true,
        "aiDescription": "Open the Creations AI settings page."
      },
      {
        "id": "textGenerator.openStories",
        "title": "Creations AI: Stories",
        "category": "Creations AI",
        "aiInvocable": true,
        "aiDescription": "Open the Story Writer: stories written in beats you steer."
      },
      {
        "id": "textGenerator.newStory",
        "title": "Creations AI: New Story",
        "category": "Creations AI",
        "aiInvocable": true,
        "aiDescription": "Start a new story in the Story Writer."
      },
      {
        "id": "textGenerator.openTables",
        "title": "Creations AI: Tables",
        "category": "Creations AI",
        "aiInvocable": true,
        "aiDescription": "Open Tables: random tables in the Perchance list grammar."
      },
      {
        "id": "textGenerator.newTable",
        "title": "Creations AI: New Table",
        "category": "Creations AI",
        "aiInvocable": true,
        "aiDescription": "Make a new random table."
      }
    ],
    "editors": [
      {
        "typeId": "text-generator-chat",
        "displayName": "Chat"
      },
      {
        "typeId": "text-generator-home",
        "displayName": "Creations AI"
      },
      {
        "typeId": "text-generator-characters",
        "displayName": "Characters"
      },
      {
        "typeId": "text-generator-settings",
        "displayName": "Settings"
      },
      {
        "typeId": "text-generator-chat-settings",
        "displayName": "Chat Settings"
      },
      {
        "typeId": "text-generator-character-editor",
        "displayName": "Character Studio"
      },
      {
        "typeId": "text-generator-story",
        "displayName": "Stories"
      },
      {
        "typeId": "text-generator-tables",
        "displayName": "Tables"
      }
    ],
    "viewContainers": [
      {
        "id": "text-generator-container",
        "title": "Creations AI",
        "icon": "px-writer",
        "location": "sidebar"
      }
    ],
    "views": [
      {
        "id": "textGenerator.home",
        "name": "Creations AI",
        "defaultContainerId": "text-generator-container"
      }
    ]
  }
}
