{
  "manifestVersion": 1,
  "id": "parallx.character-studio",
  "name": "Character Studio",
  "version": "0.1.0",
  "publisher": "parallx",
  "description": "Shape realistic people in 3D with sliders, choose their look, and export them for other 3D programs.",
  "main": "main.js",
  "activationEvents": ["onStartupFinished"],
  "engines": { "parallx": "^0.1.0" },
  "contributes": {
    "viewContainers": [
      { "id": "characterStudio-container", "title": "Character Studio", "icon": "user", "location": "sidebar" }
    ],
    "views": [
      { "id": "characterStudio.characters", "name": "Characters", "defaultContainerId": "characterStudio-container" }
    ],
    "editors": [
      { "typeId": "character-studio", "displayName": "Character Studio" }
    ],
    "commands": [
      { "id": "characterStudio.open", "title": "Open Character Studio", "category": "Character Studio" },
      { "id": "characterStudio.new", "title": "New Character", "category": "Character Studio", "icon": "plus" },
      { "id": "characterStudio.undo", "title": "Undo Character Change", "category": "Character Studio" },
      { "id": "characterStudio.redo", "title": "Redo Character Change", "category": "Character Studio" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "characterStudio.open" },
        { "command": "characterStudio.new" }
      ],
      "menubar/tools": [
        { "command": "characterStudio.open", "title": "Character Studio" }
      ]
    }
  }
}
