node_modules/
dist/
data/
.parallx/
# Claude Code: the shared parts are tracked (agents, skills, workflows, hooks,
# settings.json, memory); everything else under .claude/ is this machine's own.
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/workflows/
!.claude/hooks/
!.claude/settings.json
!.claude/memory/

# Build artifacts
*.js
*.d.ts
*.js.map
*.d.ts.map
!ext/**/*.js
!.claude/workflows/*.js
!tools/samples/**/*.js
# Hand-authored typings, not tsc output. parallx.d.ts is the public extension API
# contract (this project's vscode.d.ts) and has to be version-controlled — the
# `*.d.ts` rule above is for `declaration: true` build output.
!src/api/parallx.d.ts
!src/typings/*.d.ts

# Test artifacts
test-results/
test-output.json
test-output.txt
playwright-report/
screenshots/.git-commit-msg.txt

# Python (M94–M97). The per-workspace venv lives at <workspace>/.parallx/venv
# and never belongs to the repo, but these cover the tooling side: bytecode
# from tools/jupyter-bridge, and any venv someone creates while developing.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

.claude/scratch-recipes/

# Creations quality harnesses: temporary chat copies and scratch workspaces
ext/creations-ai/.bench-main-*.js
ext/creations-ai/test/.*-ws-*/
ext/creations-ai/test/.*-cache.json
ext/creations-ai/test/.*-cache.judge/
ext/creations-ai/test/.card-standard-sheets.json
