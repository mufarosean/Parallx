node_modules/
dist/
data/
.parallx/
.claude/

# Build artifacts
*.js
*.d.ts
*.js.map
*.d.ts.map
!ext/**/*.js
!tools/samples/**/*.js
# Hand-authored typings, not tsc output. parallx.d.ts is the public extension API
# contract (this project's vscode.d.ts) and has to be version-controlled — the
# `*.d.ts` rule above is for `declaration: true` build output.
!src/api/parallx.d.ts
!src/typings/*.d.ts

# Test artifacts
test-results/
test-output.json
test-output.txt
playwright-report/
screenshots/.git-commit-msg.txt

# Python (M94–M97). The per-workspace venv lives at <workspace>/.parallx/venv
# and never belongs to the repo, but these cover the tooling side: bytecode
# from tools/jupyter-bridge, and any venv someone creates while developing.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Media Organizer upscaler: fetched by ext/media-organizer/bin/get-realesrgan.ps1 (40MB exe + models), never committed
ext/media-organizer/bin/realesrgan-ncnn-vulkan*
ext/media-organizer/bin/models/
ext/media-organizer/bin/vcomp140*.dll
