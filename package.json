{
  "name": "parallx",
  "version": "0.1.0",
  "description": "A persistent, configurable workbench for organizing, displaying, and restoring application layouts entirely from data.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "build:prod": "tsc --noEmit && node scripts/build.mjs --production",
    "build:renderer": "node scripts/build.mjs",
    "build:watch": "tsc --watch",
    "start": "node scripts/build.mjs && electron .",
    "dev": "node scripts/build.mjs && electron .",
    "rebuild": "electron-rebuild",
    "postinstall": "electron-rebuild && node scripts/patch-deps.mjs",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:ai-eval": "npx playwright test --config=playwright.ai-eval.config.ts",
    "test:ai-eval:report": "node tests/ai-eval/aggregate.mjs",
    "test:unit": "npx vitest run",
    "test:unit:watch": "npx vitest"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@playwright/test": "^1.58.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "electron": "^40.2.1",
    "esbuild": "^0.27.3",
    "jsdom": "^28.1.0",
    "lucide-static": "^1.7.0",
    "playwright": "^1.58.2",
    "typescript": "^5.5.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@aarkue/tiptap-math-extension": "^1.4.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@tiptap/core": "^3.19.0",
    "@tiptap/extension-character-count": "^3.19.0",
    "@tiptap/extension-code-block-lowlight": "^3.19.0",
    "@tiptap/extension-color": "^3.19.0",
    "@tiptap/extension-details": "^3.19.0",
    "@tiptap/extension-highlight": "^3.19.0",
    "@tiptap/extension-image": "^3.19.0",
    "@tiptap/extension-link": "^3.19.0",
    "@tiptap/extension-placeholder": "^3.19.0",
    "@tiptap/extension-table": "^3.19.0",
    "@tiptap/extension-task-item": "^3.19.0",
    "@tiptap/extension-task-list": "^3.19.0",
    "@tiptap/extension-text-style": "^3.19.0",
    "@tiptap/extension-underline": "^3.19.0",
    "@tiptap/extension-unique-id": "3.19.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@tiptap/suggestion": "^3.19.0",
    "@types/markdown-it": "^14.1.2",
    "@univerjs/presets": "^0.25.1",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.6.2",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.28",
    "lowlight": "^3.3.0",
    "mammoth": "^1.11.0",
    "markdown-it": "^14.1.1",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-mark": "^4.0.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.624",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sqlite-vec": "^0.1.7-alpha.2",
    "tiptap-extension-auto-joiner": "^0.1.3",
    "xlsx": "^0.18.5"
  }
}
